# Environment variables read by the `janux` binary.
#
# This file is a DOCUMENTATION template only. janux does NOT auto-load any
# `.env` file — set these in the process environment (systemd Environment=,
# docker `environment:`/env_file, `export`, …) before launching the binary.
#
# The only three env vars janux reads:

# 1. Override the config file path(s). When unset, janux falls back to
#    base.toml + seed.toml in the working dir (later file wins).
JANUX_CONFIG_FILE=./janux.toml

# 2. Selects an OPTIONAL additional config layer loaded from
#    `config/<RUN_ENV>` (e.g. RUN_ENV=production -> config/production.toml,
#    merged after the primary files). Defaults to "development".
#    Also: the `JANUX` env prefix below overrides every file value.
RUN_ENV=production

# 3. Field overrides (the `JANUX` prefix + `__` separator, nested with `__`).
#    These override every value from the TOML config files.
JANUX__bind__port=8080
JANUX__data_dir=./data

# Prefer the env var over putting the key in base.toml for production:
#   JANUX__encryption_key=<64 hex chars, e.g. `openssl rand -hex 32`>
# Required at boot. Stable across restarts, or the data dir won't decrypt.
JANUX__encryption_key=

# 4. Verbose error diagnostics. When ON, 401/403 failure responses carry the
#    full reason in their `detail` field (which token check failed, which role
#    is missing) — invaluable while developing, but a client can then learn how
#    to defeat a gate, so NEVER leave it on a reachable host.
#
#    `debug` follows the run environment when unset: `RUN_ENV=development`
#    (the default) enables it, `RUN_ENV=production` keeps it fail-closed. Set
#    this only to override the RUN_ENV default:
JANUX__debug=true
