# Copy to .env and fill in real values. .env is gitignored.

# ============ SMS / LLM (Aliyun) ============
DASHSCOPE_API_KEY=your-dashscope-api-key
YOUR_APP_ID=your-app-id
APPKEY=your-appkey
ALIBABA_CLOUD_ACCESS_KEY_ID=your-access-key-id
ALIBABA_CLOUD_ACCESS_KEY_SECRET=your-access-key-secret
MODELSTUDIO_WORKSPACE_ID=your-workspace-id
MODELSTUDIO_AGENT_ID=your-agent-id

DASHSCOPE_MODEL_NAME=qwen-turbo
BUCKET_NAME=your-bucket-name
OSS_ENDPOINT=https://oss-cn-shanghai.aliyuncs.com
OSS_REGION=cn-shanghai

# ============ Mail (for magic link auth) ============
RESEND_API_KEY=your-resend-api-key
MAIL_FROM=noreply@example.com
MAIL_MAGIC_LINK_EXPIRY_MINUTES=15

# ============ Management UI & OAuth2 ============

# JWT Configuration
JWT_SECRET_KEY=your-secret-key-here
SESSION_TOKEN_EXPIRY_MINUTES=1440

RAG_API_BASE_URL=https://bailian.cn-beijing.aliyuncs.com
RAG_API_KEY=your-rag-api-key
RAG_API_TIMEOUT_SECONDS=30

# Bailian (Model Studio) Knowledge Base
RAG_KNOWLEDGE_BASE_ID=your-knowledge-base-id
RAG_CATEGORY_ID=default
RAG_BAILIAN_ENDPOINT=bailian.cn-beijing.aliyuncs.com

# OAuth2 Providers (optional - set any combination)

# GitHub OAuth
OAUTH_GITHUB_CLIENT_ID=your-github-client-id
OAUTH_GITHUB_CLIENT_SECRET=your-github-client-secret
